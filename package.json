{
  "name": "rawcut-global",
  "version": "0.1.2",
  "description": "영상을 넣으면 영어 립싱크 더빙으로 돌려주는 데스크톱 앱",
  "main": "./out/main/index.js",
  "author": "TitanZ 전략기획실",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:win": "npm run build && electron-builder --win",
    "pack:all": "npm run build && electron-builder --mac --win",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@electron/osx-sign": "^1.3.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "build": {
    "appId": "kr.co.titanz.rawcutglobal",
    "productName": "RAWCUT GLOBAL",
    "copyright": "Copyright © 2026 TitanZ",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "artifactName": "RAWCUT-GLOBAL-${version}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "sign": "build/sign-mac.cjs",
      "notarize": false
    },
    "dmg": {
      "title": "${productName}",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RAWCUT GLOBAL"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
