# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
#
# 여기에 값을 넣어두면 로그인 화면에 입력칸이 뜨지 않고 버튼만 보입니다.
# OAuth 클라이언트 ID 는 비밀이 아니므로 바이너리에 들어가도 됩니다.

# Google Cloud Console → 사용자 인증 정보 → OAuth 클라이언트 ID
# 애플리케이션 유형은 반드시 "데스크톱 앱" 이어야 합니다.
GOOGLE_CLIENT_ID=
# 데스크톱 클라이언트에도 발급됩니다. Google 문서상 기밀이 아니며 실제 보호는 PKCE 가 합니다.
GOOGLE_CLIENT_SECRET=

# 로그인 허용 도메인(쉼표 구분). 비워두면 titan.kr 로 잠깁니다.
ALLOWED_DOMAINS=titan.kr

